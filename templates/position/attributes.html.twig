{% extends 'base.html.twig' %}
{% block title %}Позиция атрибуттары{% endblock %}
{% block body %}
<div style="max-width:600px;margin:40px auto;font-family:sans-serif;">
    <h1>{{ position.title }} — атрибуттар</h1>

    <h3>Тіркелген атрибуттар</h3>
    <table border="1" cellpadding="8" style="width:100%;border-collapse:collapse;">
        <thead><tr><th>Атау</th><th>Тип</th><th></th></tr></thead>
        <tbody>
        {% for pa in position.positionAttributes %}
            <tr>
                <td>{{ pa.attribute.name }}</td>
                <td>{{ pa.attribute.type.value }}</td>
                <td>
                    <form method="post" action="{{ path('position_attribute_remove', {paId: pa.id}) }}">
                        <button type="submit">Алып тастау</button>
                    </form>
                </td>
            </tr>
        {% else %}
            <tr><td colspan="3">Атрибут тіркелмеген.</td></tr>
        {% endfor %}
        </tbody>
    </table>

    <h3 style="margin-top:24px;">Атрибут қосу</h3>
    <form method="post" action="{{ path('position_attribute_add', {id: position.id}) }}">
        <select name="attribute_id">
            {% for attr in available %}
                <option value="{{ attr.id }}">{{ attr.name }} ({{ attr.type.value }})</option>
            {% endfor %}
        </select>
        <button type="submit">Қосу</button>
    </form>

    <p style="margin-top:16px;"><a href="{{ path('position_edit', {id: position.id}) }}">← Позицияға оралу</a></p>
</div>
{% endblock %}
