{% extends 'base.html.twig' %}
{% block title %}Кіру{% endblock %}
{% block body %}
<div style="max-width:420px;margin:60px auto;font-family:sans-serif;">
    <h1>Кіру</h1>
    {% if error %}<div style="color:red;">{{ error.messageKey|trans(error.messageData, 'security') }}</div>{% endif %}
    <form method="post">
        <label>Email</label>
        <input type="email" name="_username" value="{{ last_username }}" required autofocus>
        <label>Password</label>
        <input type="password" name="_password" required>
        <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
        <button type="submit">Кіру</button>
    </form>
    <p><a href="{{ path('app_register') }}">Тіркелу</a></p>
</div>
{% endblock %}
