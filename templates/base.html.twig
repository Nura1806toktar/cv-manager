<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}CV Manager{% endblock %}</title>
    <link rel="icon" href="data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><text y=%22.9em%22 font-size=%2290%22>📄</text></svg>">
    {% block stylesheets %}{{ importmap('app') }}{% endblock %}
</head>
<body style="margin:0;font-family:sans-serif;">
    <header style="background:#222;color:#fff;padding:12px 24px;display:flex;align-items:center;gap:24px;">
        <a href="{{ path('app_home') }}" style="color:#fff;text-decoration:none;font-weight:bold;">CV Manager</a>
        <a href="{{ path('position_index') }}" style="color:#fff;">Позициялар</a>
        {% if is_granted('ROLE_USER') %}
            <a href="{{ path('profile_index') }}" style="color:#fff;">Профиль</a>
        {% endif %}
        {% if is_granted('ROLE_RECRUITER') %}
            <a href="{{ path('attribute_index') }}" style="color:#fff;">Атрибуттар</a>
        {% endif %}

        <form method="get" action="{{ path('position_index') }}" style="margin-left:auto;">
            <input type="text" name="q" placeholder="Іздеу..." style="padding:4px 8px;">
        </form>

        {% if is_granted('ROLE_USER') %}
            <span>{{ app.user.email }}</span>
            <a href="{{ path('app_logout') }}" style="color:#fff;">Шығу</a>
        {% else %}
            <a href="{{ path('app_login') }}" style="color:#fff;">Кіру</a>
            <a href="{{ path('app_register') }}" style="color:#fff;">Тіркелу</a>
        {% endif %}
    </header>

    <main>
        {% block body %}{% endblock %}
    </main>

    {% block javascripts %}{% endblock %}
</body>
</html>
